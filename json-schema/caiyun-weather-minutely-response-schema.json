  "title": "MinutelyResponse",
  "description": "MinutelyResponse schema from Caiyun Weather API",
  "allOf": [
    {
      "$ref": "#/components/schemas/EnvelopeBase"
    },
    {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "properties": {

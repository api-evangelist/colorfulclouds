          "request": {
            "name": "Caiyun Weather Get Severe Weather Alerts",
            "description": {
              "content": "Returns the active severe-weather alerts published by the China Meteorological Administration for the requested location, including title, code, status, description, region (province/city/county), adcode, publication timestamp, and originating source.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":token",
                ":lnglat",
                "alert"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "en_US",
                  "description": "Response language for description fields."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "token",
                  "description": "(Required) Caiyun Weather API token issued by the Open Platform (platform.caiyunapp.com). Embedded in the path rather than a header."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "lnglat",
                  "description": "(Required) Longitude,latitude tuple as `lng,lat` (note the order — longitude first). Use WGS84 decimal degrees."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null

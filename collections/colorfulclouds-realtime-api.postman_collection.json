          "name": "Caiyun Weather Get Realtime Weather",
          "request": {
            "name": "Caiyun Weather Get Realtime Weather",
            "description": {
              "content": "Returns the current weather conditions at the requested location — temperature, humidity, wind, cloud cover, sky condition (skycon), visibility, downward shortwave radiation, pressure, apparent temperature, precipitation, air quality, and life indices.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":token",
                ":lnglat",
                "realtime"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "en_US",
                  "description": "Response language for description fields."
                },
                {
                  "disabled": false,
                  "key": "unit",
                  "value": "metric",
                  "description": "Unit system for numeric values (temperature, wind, precipitation, pressure)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "token",
                  "description": "(Required) Caiyun Weather API token issued by the Open Platform (platform.caiyunapp.com). Embedded in the path rather than a header."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "lnglat",
                  "description": "(Required) Longitude,latitude tuple as `lng,lat` (note the order — longitude first). Use WGS84 decimal degrees."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },

      "item": [
        {
          "id": "3b5243d5-652a-4d3c-90c0-3301048ecfa2",
          "name": "Caiyun Weather Get Precipitation Map Tile",
          "request": {
            "name": "Caiyun Weather Get Precipitation Map Tile",
            "description": {
              "content": "Returns a 256x256 PNG raster tile representing radar + nowcast precipitation intensity colored by the standard dBZ palette. Suitable for overlaying on Web Mercator base maps (Mapbox, MapLibre, OpenLayers, Leaflet) to render live precipitation animations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "precipitation",
                ":z",
                ":x",
                "{{y}}.png"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<integer>",
                  "description": "Optional Unix epoch second for the nowcast frame. Omit to receive the most recent observation; provide a future timestamp within the nowcast horizon to render a forecast frame."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "z",
                  "description": "(Required) Web Mercator zoom level (0-9 typical)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "x",
                  "description": "(Required) Web Mercator tile column."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/png"
              }
            ],
            "method": "GET",
            "auth": null

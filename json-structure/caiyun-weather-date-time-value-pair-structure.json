{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/colorfulclouds/refs/heads/main/json-structure/caiyun-weather-date-time-value-pair-structure.json",
  "name": "DateTimeValuePair",
  "description": "DateTimeValuePair schema from Caiyun Weather API",
  "type": "object",
  "properties": {
    "datetime": {
      "type": "datetime",
      "example": "2026-05-30T15:00:00+08:00"
    },
    "value": {
      "type": "float",
      "example": 23.1
    }
  },
  "required": [
    "datetime",
    "value"
  ]
}